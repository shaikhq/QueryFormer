Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_PROMO_SK,
  TPCDS.DATE_DIM2.D_FIRST_DOM 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.CATALOG_SALES.CS_ITEM_SK = 12523 AND 
  TPCDS.CATALOG_SALES.CS_WAREHOUSE_SK <= 3


Optimized Statement:
-------------------
SELECT 
  Q1.CS_PROMO_SK AS "CS_PROMO_SK",
  Q2.D_FIRST_DOM AS "D_FIRST_DOM" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (Q1.CS_WAREHOUSE_SK <= 3) AND 
  (Q1.CS_ITEM_SK = 12523)

