Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_EXT_LIST_PRICE,
  TPCDS.DATE_DIM2.D_FIRST_DOM 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_SHIP_CDEMO_SK <= 110372 AND 
  TPCDS.WEB_SALES.WS_ITEM_SK >= 16081


Optimized Statement:
-------------------
SELECT 
  Q1.WS_EXT_LIST_PRICE AS "WS_EXT_LIST_PRICE",
  Q2.D_FIRST_DOM AS "D_FIRST_DOM" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (16081 <= Q1.WS_ITEM_SK) AND 
  (Q1.WS_SHIP_CDEMO_SK <= 110372)

