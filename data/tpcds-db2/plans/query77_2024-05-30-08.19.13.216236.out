Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_NET_PAID_INC_TAX,
  TPCDS.DATE_DIM2.D_FIRST_DOM 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_NET_PAID_INC_SHIP_TAX <= +05643.61 AND 
  TPCDS.WEB_SALES.WS_BILL_CDEMO_SK >= 267870


Optimized Statement:
-------------------
SELECT 
  Q1.WS_NET_PAID_INC_TAX AS "WS_NET_PAID_INC_TAX",
  Q2.D_FIRST_DOM AS "D_FIRST_DOM" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (267870 <= Q1.WS_BILL_CDEMO_SK) AND 
  (Q1.WS_NET_PAID_INC_SHIP_TAX <= +05643.61)

