Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_PAGE.CP_START_DATE_SK,
  TPCDS.DATE_DIM2.D_MOY 
FROM 
  TPCDS.CATALOG_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_PAGE.CP_END_DATE_SK 
WHERE 
  TPCDS.CATALOG_PAGE.CP_START_DATE_SK = 2451180 AND 
  TPCDS.DATE_DIM2.D_SAME_DAY_LQ >= 2415150


Optimized Statement:
-------------------
SELECT 
  2451180 AS "CP_START_DATE_SK",
  Q2.D_MOY AS "D_MOY" 
FROM 
  TPCDS.CATALOG_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CP_END_DATE_SK) AND 
  (2415150 <= Q2.D_SAME_DAY_LQ) AND 
  (Q1.CP_START_DATE_SK = 2451180)

