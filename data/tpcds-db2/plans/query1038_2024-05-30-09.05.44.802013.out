Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_BIRTH_DAY,
  TPCDS.DATE_DIM2.D_QUARTER_SEQ 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_CURRENT_HDEMO_SK >= 396 AND 
  TPCDS.CUSTOMER.C_BIRTH_DAY = 24


Optimized Statement:
-------------------
SELECT 
  24 AS "C_BIRTH_DAY",
  Q2.D_QUARTER_SEQ AS "D_QUARTER_SEQ" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q1.C_BIRTH_DAY = 24) AND 
  (396 <= Q1.C_CURRENT_HDEMO_SK)

Explain level:    Explain from section

