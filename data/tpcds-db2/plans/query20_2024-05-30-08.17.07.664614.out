Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_NET_PAID_INC_SHIP,
  TPCDS.DATE_DIM2.D_DOW 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_ORDER_NUMBER <= 17341 AND 
  TPCDS.WEB_SALES.WS_ITEM_SK <= 4861


Optimized Statement:
-------------------
SELECT 
  Q1.WS_NET_PAID_INC_SHIP AS "WS_NET_PAID_INC_SHIP",
  Q2.D_DOW AS "D_DOW" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (Q1.WS_ITEM_SK <= 4861) AND 
  (Q1.WS_ORDER_NUMBER <= 17341)

