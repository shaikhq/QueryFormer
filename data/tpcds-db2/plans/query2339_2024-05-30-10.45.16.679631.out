Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_FIRST_SALES_DATE_SK,
  TPCDS.DATE_DIM2.D_FY_YEAR 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_CUSTOMER_SK <= 73766 AND 
  TPCDS.CUSTOMER.C_BIRTH_DAY = 27


Optimized Statement:
-------------------
SELECT 
  Q1.C_FIRST_SALES_DATE_SK AS "C_FIRST_SALES_DATE_SK",
  Q2.D_FY_YEAR AS "D_FY_YEAR" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q1.C_BIRTH_DAY = 27) AND 
  (Q1.C_CUSTOMER_SK <= 73766)

Explain level:    Explain from section

