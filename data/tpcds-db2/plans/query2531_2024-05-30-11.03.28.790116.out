Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_SK,
  TPCDS.DATE_DIM2.D_LAST_DOM 
FROM 
  TPCDS.CATALOG_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_PAGE.CP_END_DATE_SK 
WHERE 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_SK >= 11191 AND 
  TPCDS.DATE_DIM2.D_FY_WEEK_SEQ <= 7848


Optimized Statement:
-------------------
SELECT 
  Q1.CP_CATALOG_PAGE_SK AS "CP_CATALOG_PAGE_SK",
  Q2.D_LAST_DOM AS "D_LAST_DOM" 
FROM 
  TPCDS.CATALOG_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CP_END_DATE_SK) AND 
  (Q2.D_FY_WEEK_SEQ <= 7848) AND 
  (11191 <= Q1.CP_CATALOG_PAGE_SK)

