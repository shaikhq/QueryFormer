Original Statement:
------------------
SELECT 
  TPCDS.PROMOTION.P_RESPONSE_TARGET,
  TPCDS.DATE_DIM2.D_QUARTER_SEQ 
FROM 
  TPCDS.PROMOTION 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.PROMOTION.P_END_DATE_SK 
WHERE 
  TPCDS.PROMOTION.P_END_DATE_SK <= 2450365 AND 
  TPCDS.PROMOTION.P_COST >= +0000000001000.00


Optimized Statement:
-------------------
SELECT 
  Q1.P_RESPONSE_TARGET AS "P_RESPONSE_TARGET",
  Q2.D_QUARTER_SEQ AS "D_QUARTER_SEQ" 
FROM 
  TPCDS.PROMOTION AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.P_END_DATE_SK) AND 
  (+0000000001000.00 <= Q1.P_COST) AND 
  (Q1.P_END_DATE_SK <= 2450365)

