Original Statement:
------------------
SELECT 
  TPCDS.PROMOTION.P_RESPONSE_TARGET,
  TPCDS.DATE_DIM2.D_DOW 
FROM 
  TPCDS.PROMOTION 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.PROMOTION.P_END_DATE_SK 
WHERE 
  TPCDS.PROMOTION.P_END_DATE_SK = 2450742 AND 
  TPCDS.DATE_DIM2.D_DOW >= 1


Optimized Statement:
-------------------
SELECT 
  Q1.P_RESPONSE_TARGET AS "P_RESPONSE_TARGET",
  Q2.D_DOW AS "D_DOW" 
FROM 
  TPCDS.PROMOTION AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = 2450742) AND 
  (1 <= Q2.D_DOW) AND 
  (Q1.P_END_DATE_SK = 2450742)

