Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_FIRST_SALES_DATE_SK,
  TPCDS.DATE_DIM2.D_SAME_DAY_LQ 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_CUSTOMER_SK <= 63228 AND 
  TPCDS.DATE_DIM2.D_DATE_SK <= 2453468


Optimized Statement:
-------------------
SELECT 
  Q1.C_FIRST_SALES_DATE_SK AS "C_FIRST_SALES_DATE_SK",
  Q2.D_SAME_DAY_LQ AS "D_SAME_DAY_LQ" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q1.C_FIRST_SHIPTO_DATE_SK <= 2453468) AND 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q1.C_CUSTOMER_SK <= 63228)

