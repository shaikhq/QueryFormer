Original Statement:
------------------
SELECT 
  TPCDS.WEB_PAGE.WP_MAX_AD_COUNT,
  TPCDS.DATE_DIM2.D_FY_YEAR 
FROM 
  TPCDS.WEB_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK 
WHERE 
  TPCDS.WEB_PAGE.WP_WEB_PAGE_SK >= 16 AND 
  TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK >= 2452623


Optimized Statement:
-------------------
SELECT 
  Q1.WP_MAX_AD_COUNT AS "WP_MAX_AD_COUNT",
  Q2.D_FY_YEAR AS "D_FY_YEAR" 
FROM 
  TPCDS.WEB_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WP_ACCESS_DATE_SK) AND 
  (2452623 <= Q1.WP_ACCESS_DATE_SK) AND 
  (16 <= Q1.WP_WEB_PAGE_SK)

