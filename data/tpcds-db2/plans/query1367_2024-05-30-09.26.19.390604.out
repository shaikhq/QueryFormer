Original Statement:
------------------
SELECT 
  TPCDS.WEB_PAGE.WP_LINK_COUNT,
  TPCDS.DATE_DIM2.D_QOY 
FROM 
  TPCDS.WEB_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK 
WHERE 
  TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK >= 2452620 AND 
  TPCDS.DATE_DIM2.D_WEEK_SEQ <= 8445


Optimized Statement:
-------------------
SELECT 
  Q1.WP_LINK_COUNT AS "WP_LINK_COUNT",
  Q2.D_QOY AS "D_QOY" 
FROM 
  TPCDS.WEB_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WP_ACCESS_DATE_SK) AND 
  (Q2.D_WEEK_SEQ <= 8445) AND 
  (2452620 <= Q1.WP_ACCESS_DATE_SK)

