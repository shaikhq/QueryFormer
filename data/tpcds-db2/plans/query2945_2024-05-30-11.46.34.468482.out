Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_ORDER_NUMBER,
  TPCDS.DATE_DIM2.D_DATE_SK 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_WAREHOUSE_SK <= 1 AND 
  TPCDS.WEB_SALES.WS_ITEM_SK = 16111


Optimized Statement:
-------------------
SELECT 
  Q1.WS_ORDER_NUMBER AS "WS_ORDER_NUMBER",
  Q2.D_DATE_SK AS "D_DATE_SK" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (Q1.WS_ITEM_SK = 16111) AND 
  (Q1.WS_WAREHOUSE_SK <= 1)

