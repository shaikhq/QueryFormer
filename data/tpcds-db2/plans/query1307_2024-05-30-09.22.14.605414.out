Original Statement:
------------------
SELECT 
  TPCDS.DATE_DIM2.D_YEAR,
  TPCDS.PROMOTION.P_PROMO_SK 
FROM 
  TPCDS.DATE_DIM2 
  INNER JOIN TPCDS.PROMOTION 
  ON TPCDS.PROMOTION.P_END_DATE_SK = TPCDS.DATE_DIM2.D_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_DOM = 22 AND 
  TPCDS.PROMOTION.P_COST = +0000000001000.00


Optimized Statement:
-------------------
SELECT 
  Q1.D_YEAR AS "D_YEAR",
  Q2.P_PROMO_SK AS "P_PROMO_SK" 
FROM 
  TPCDS.DATE_DIM2 AS Q1,
  TPCDS.PROMOTION AS Q2 
WHERE 
  (Q2.P_END_DATE_SK = Q1.D_DATE_SK) AND 
  (Q2.P_COST = +0000000001000.00) AND 
  (Q1.D_DOM = 22)

Explain level:    Explain from section

