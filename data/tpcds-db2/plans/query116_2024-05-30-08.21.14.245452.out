Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_EXT_SHIP_COST,
  TPCDS.DATE_DIM2.D_QOY 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.CATALOG_SALES.CS_ITEM_SK = 10411 AND 
  TPCDS.DATE_DIM2.D_DOW >= 3


Optimized Statement:
-------------------
SELECT 
  Q1.CS_EXT_SHIP_COST AS "CS_EXT_SHIP_COST",
  Q2.D_QOY AS "D_QOY" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (3 <= Q2.D_DOW) AND 
  (Q1.CS_ITEM_SK = 10411)

