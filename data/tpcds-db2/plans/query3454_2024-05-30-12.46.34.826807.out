Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK,
  TPCDS.DATE_DIM2.D_DOW 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_SAME_DAY_LY >= 2430330 AND 
  TPCDS.CUSTOMER.C_BIRTH_DAY = 20


Optimized Statement:
-------------------
SELECT 
  Q1.C_FIRST_SHIPTO_DATE_SK AS "C_FIRST_SHIPTO_DATE_SK",
  Q2.D_DOW AS "D_DOW" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q1.C_BIRTH_DAY = 20) AND 
  (2430330 <= Q2.D_SAME_DAY_LY)

Explain level:    Explain from section

