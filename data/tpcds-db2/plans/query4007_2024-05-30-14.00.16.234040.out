Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_SHIP_HDEMO_SK,
  TPCDS.DATE_DIM2.D_FY_WEEK_SEQ 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_SHIP_DATE_SK >= 2452752 AND 
  TPCDS.WEB_SALES.WS_ORDER_NUMBER <= 16204


Optimized Statement:
-------------------
SELECT 
  Q1.WS_SHIP_HDEMO_SK AS "WS_SHIP_HDEMO_SK",
  Q2.D_FY_WEEK_SEQ AS "D_FY_WEEK_SEQ" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (Q1.WS_ORDER_NUMBER <= 16204) AND 
  (2452752 <= Q1.WS_SHIP_DATE_SK)

