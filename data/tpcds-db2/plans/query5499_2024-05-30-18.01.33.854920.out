Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_BIRTH_MONTH,
  TPCDS.DATE_DIM2.D_WEEK_SEQ 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK <= 2450497 AND 
  TPCDS.CUSTOMER.C_CUSTOMER_SK <= 26345


Optimized Statement:
-------------------
SELECT 
  Q1.C_BIRTH_MONTH AS "C_BIRTH_MONTH",
  Q2.D_WEEK_SEQ AS "D_WEEK_SEQ" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q1.C_CUSTOMER_SK <= 26345) AND 
  (Q1.C_FIRST_SHIPTO_DATE_SK <= 2450497)

