Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_CURRENT_ADDR_SK,
  TPCDS.DATE_DIM2.D_DATE_SK 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_CUSTOMER_SK >= 73766 AND 
  TPCDS.DATE_DIM2.D_DATE_SK >= 2415022


Optimized Statement:
-------------------
SELECT 
  Q1.C_CURRENT_ADDR_SK AS "C_CURRENT_ADDR_SK",
  Q2.D_DATE_SK AS "D_DATE_SK" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (2415022 <= Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (73766 <= Q1.C_CUSTOMER_SK)

Explain level:    Explain from section

