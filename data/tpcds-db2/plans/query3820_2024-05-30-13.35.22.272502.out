Original Statement:
------------------
SELECT 
  TPCDS.STORE.S_COMPANY_ID,
  TPCDS.DATE_DIM2.D_MONTH_SEQ 
FROM 
  TPCDS.STORE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.STORE.S_CLOSED_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_SAME_DAY_LY >= 2414746 AND 
  TPCDS.DATE_DIM2.D_DATE_SK <= 2468847


Optimized Statement:
-------------------
SELECT 
  Q1.S_COMPANY_ID AS "S_COMPANY_ID",
  Q2.D_MONTH_SEQ AS "D_MONTH_SEQ" 
FROM 
  TPCDS.STORE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.S_CLOSED_DATE_SK) AND 
  (Q2.D_DATE_SK <= 2468847) AND 
  (2414746 <= Q2.D_SAME_DAY_LY)

