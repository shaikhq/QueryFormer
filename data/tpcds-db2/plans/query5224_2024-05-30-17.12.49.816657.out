Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_CURRENT_HDEMO_SK,
  TPCDS.DATE_DIM2.D_SAME_DAY_LQ 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_CURRENT_CDEMO_SK <= 1364027 AND 
  TPCDS.CUSTOMER.C_CUSTOMER_SK >= 15807


Optimized Statement:
-------------------
SELECT 
  Q1.C_CURRENT_HDEMO_SK AS "C_CURRENT_HDEMO_SK",
  Q2.D_SAME_DAY_LQ AS "D_SAME_DAY_LQ" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (15807 <= Q1.C_CUSTOMER_SK) AND 
  (Q1.C_CURRENT_CDEMO_SK <= 1364027)

Explain level:    Explain from section

