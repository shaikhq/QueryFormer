Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_QUANTITY,
  TPCDS.DATE_DIM2.D_WEEK_SEQ 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.CATALOG_SALES.CS_ORDER_NUMBER = 48119 AND 
  TPCDS.DATE_DIM2.D_DATE_SK >= 2434244


Optimized Statement:
-------------------
SELECT 
  Q1.CS_QUANTITY AS "CS_QUANTITY",
  Q2.D_WEEK_SEQ AS "D_WEEK_SEQ" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (2434244 <= Q1.CS_SHIP_DATE_SK) AND 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (Q1.CS_ORDER_NUMBER = 48119)

