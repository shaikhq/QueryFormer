Original Statement:
------------------
SELECT 
  TPCDS.DATE_DIM2.D_QUARTER_SEQ,
  TPCDS.CATALOG_PAGE.CP_START_DATE_SK 
FROM 
  TPCDS.DATE_DIM2 
  INNER JOIN TPCDS.CATALOG_PAGE 
  ON TPCDS.CATALOG_PAGE.CP_END_DATE_SK = TPCDS.DATE_DIM2.D_DATE_SK 
WHERE 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_SK <= 5596 AND 
  TPCDS.DATE_DIM2.D_DOW <= 2


Optimized Statement:
-------------------
SELECT 
  Q1.D_QUARTER_SEQ AS "D_QUARTER_SEQ",
  Q2.CP_START_DATE_SK AS "CP_START_DATE_SK" 
FROM 
  TPCDS.DATE_DIM2 AS Q1,
  TPCDS.CATALOG_PAGE AS Q2 
WHERE 
  (Q2.CP_END_DATE_SK = Q1.D_DATE_SK) AND 
  (Q1.D_DOW <= 2) AND 
  (Q2.CP_CATALOG_PAGE_SK <= 5596)

