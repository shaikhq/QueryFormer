Original Statement:
------------------
SELECT 
  TPCDS.DATE_DIM2.D_FY_WEEK_SEQ,
  TPCDS.CUSTOMER.C_CURRENT_HDEMO_SK 
FROM 
  TPCDS.DATE_DIM2 
  INNER JOIN TPCDS.CUSTOMER 
  ON TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK = TPCDS.DATE_DIM2.D_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK >= 2451217 AND 
  TPCDS.DATE_DIM2.D_FY_QUARTER_SEQ >= 200


Optimized Statement:
-------------------
SELECT 
  Q1.D_FY_WEEK_SEQ AS "D_FY_WEEK_SEQ",
  Q2.C_CURRENT_HDEMO_SK AS "C_CURRENT_HDEMO_SK" 
FROM 
  TPCDS.DATE_DIM2 AS Q1,
  TPCDS.CUSTOMER AS Q2 
WHERE 
  (Q2.C_FIRST_SHIPTO_DATE_SK = Q1.D_DATE_SK) AND 
  (200 <= Q1.D_FY_QUARTER_SEQ) AND 
  (2451217 <= Q2.C_FIRST_SHIPTO_DATE_SK)

