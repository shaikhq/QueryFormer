Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_BILL_HDEMO_SK,
  TPCDS.DATE_DIM2.D_LAST_DOM 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.CATALOG_SALES.CS_ITEM_SK >= 15289 AND 
  TPCDS.CATALOG_SALES.CS_BILL_HDEMO_SK = 5784


Optimized Statement:
-------------------
SELECT 
  5784 AS "CS_BILL_HDEMO_SK",
  Q2.D_LAST_DOM AS "D_LAST_DOM" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (Q1.CS_BILL_HDEMO_SK = 5784) AND 
  (15289 <= Q1.CS_ITEM_SK)

