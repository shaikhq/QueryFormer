Original Statement:
------------------
SELECT 
  TPCDS.DATE_DIM2.D_WEEK_SEQ,
  TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK 
FROM 
  TPCDS.DATE_DIM2 
  INNER JOIN TPCDS.WEB_PAGE 
  ON TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK = TPCDS.DATE_DIM2.D_DATE_SK 
WHERE 
  TPCDS.WEB_PAGE.WP_WEB_PAGE_SK <= 44 AND 
  TPCDS.WEB_PAGE.WP_CHAR_COUNT <= 3732


Optimized Statement:
-------------------
SELECT 
  Q1.D_WEEK_SEQ AS "D_WEEK_SEQ",
  Q2.WP_ACCESS_DATE_SK AS "WP_ACCESS_DATE_SK" 
FROM 
  TPCDS.DATE_DIM2 AS Q1,
  TPCDS.WEB_PAGE AS Q2 
WHERE 
  (Q2.WP_ACCESS_DATE_SK = Q1.D_DATE_SK) AND 
  (Q2.WP_CHAR_COUNT <= 3732) AND 
  (Q2.WP_WEB_PAGE_SK <= 44)

