Original Statement:
------------------
SELECT 
  TPCDS.WEB_PAGE.WP_CHAR_COUNT,
  TPCDS.DATE_DIM2.D_YEAR 
FROM 
  TPCDS.WEB_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_FY_YEAR <= 2059 AND 
  TPCDS.DATE_DIM2.D_FIRST_DOM >= 2420711


Optimized Statement:
-------------------
SELECT 
  Q1.WP_CHAR_COUNT AS "WP_CHAR_COUNT",
  Q2.D_YEAR AS "D_YEAR" 
FROM 
  TPCDS.WEB_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WP_ACCESS_DATE_SK) AND 
  (2420711 <= Q2.D_FIRST_DOM) AND 
  (Q2.D_FY_YEAR <= 2059)

