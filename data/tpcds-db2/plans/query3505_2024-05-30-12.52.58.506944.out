Original Statement:
------------------
SELECT 
  TPCDS.PROMOTION.P_ITEM_SK,
  TPCDS.DATE_DIM2.D_DATE_SK 
FROM 
  TPCDS.PROMOTION 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.PROMOTION.P_END_DATE_SK 
WHERE 
  TPCDS.PROMOTION.P_ITEM_SK = 14440 AND 
  TPCDS.PROMOTION.P_COST <= +0000000001000.00


Optimized Statement:
-------------------
SELECT 
  14440 AS "P_ITEM_SK",
  Q2.D_DATE_SK AS "D_DATE_SK" 
FROM 
  TPCDS.PROMOTION AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.P_END_DATE_SK) AND 
  (Q1.P_COST <= +0000000001000.00) AND 
  (Q1.P_ITEM_SK = 14440)

