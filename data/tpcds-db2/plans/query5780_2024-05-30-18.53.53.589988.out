Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_CUSTOMER_SK,
  TPCDS.DATE_DIM2.D_DOM 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_QOY >= 3 AND 
  TPCDS.CUSTOMER.C_CUSTOMER_SK >= 42152


Optimized Statement:
-------------------
SELECT 
  Q1.C_CUSTOMER_SK AS "C_CUSTOMER_SK",
  Q2.D_DOM AS "D_DOM" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (42152 <= Q1.C_CUSTOMER_SK) AND 
  (3 <= Q2.D_QOY)

Explain level:    Explain from section

