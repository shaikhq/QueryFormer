Original Statement:
------------------
SELECT 
  TPCDS.DATE_DIM2.D_LAST_DOM,
  TPCDS.CATALOG_PAGE.CP_END_DATE_SK 
FROM 
  TPCDS.DATE_DIM2 
  INNER JOIN TPCDS.CATALOG_PAGE 
  ON TPCDS.CATALOG_PAGE.CP_END_DATE_SK = TPCDS.DATE_DIM2.D_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_DOM >= 5 AND 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_SK <= 622


Optimized Statement:
-------------------
SELECT 
  Q1.D_LAST_DOM AS "D_LAST_DOM",
  Q2.CP_END_DATE_SK AS "CP_END_DATE_SK" 
FROM 
  TPCDS.DATE_DIM2 AS Q1,
  TPCDS.CATALOG_PAGE AS Q2 
WHERE 
  (Q2.CP_END_DATE_SK = Q1.D_DATE_SK) AND 
  (Q2.CP_CATALOG_PAGE_SK <= 622) AND 
  (5 <= Q1.D_DOM)

