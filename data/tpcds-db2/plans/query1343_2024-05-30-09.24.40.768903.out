Original Statement:
------------------
SELECT 
  TPCDS.WEB_PAGE.WP_WEB_PAGE_SK,
  TPCDS.DATE_DIM2.D_SAME_DAY_LQ 
FROM 
  TPCDS.WEB_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK 
WHERE 
  TPCDS.WEB_PAGE.WP_CHAR_COUNT <= 3128 AND 
  TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK = 2452574


Optimized Statement:
-------------------
SELECT 
  Q1.WP_WEB_PAGE_SK AS "WP_WEB_PAGE_SK",
  Q2.D_SAME_DAY_LQ AS "D_SAME_DAY_LQ" 
FROM 
  TPCDS.WEB_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = 2452574) AND 
  (Q1.WP_ACCESS_DATE_SK = 2452574) AND 
  (Q1.WP_CHAR_COUNT <= 3128)

