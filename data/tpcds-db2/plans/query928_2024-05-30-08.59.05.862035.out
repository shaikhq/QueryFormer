Original Statement:
------------------
SELECT 
  TPCDS.DATE_DIM2.D_MONTH_SEQ,
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_NUMBER 
FROM 
  TPCDS.DATE_DIM2 
  INNER JOIN TPCDS.CATALOG_PAGE 
  ON TPCDS.CATALOG_PAGE.CP_END_DATE_SK = TPCDS.DATE_DIM2.D_DATE_SK 
WHERE 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_SK >= 5596 AND 
  TPCDS.DATE_DIM2.D_QOY = 2


Optimized Statement:
-------------------
SELECT 
  Q1.D_MONTH_SEQ AS "D_MONTH_SEQ",
  Q2.CP_CATALOG_PAGE_NUMBER AS "CP_CATALOG_PAGE_NUMBER" 
FROM 
  TPCDS.DATE_DIM2 AS Q1,
  TPCDS.CATALOG_PAGE AS Q2 
WHERE 
  (Q2.CP_END_DATE_SK = Q1.D_DATE_SK) AND 
  (Q1.D_QOY = 2) AND 
  (5596 <= Q2.CP_CATALOG_PAGE_SK)

