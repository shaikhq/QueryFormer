Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_PAGE.CP_START_DATE_SK,
  TPCDS.DATE_DIM2.D_FY_QUARTER_SEQ 
FROM 
  TPCDS.CATALOG_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_PAGE.CP_END_DATE_SK 
WHERE 
  TPCDS.CATALOG_PAGE.CP_END_DATE_SK >= 2451543 AND 
  TPCDS.CATALOG_PAGE.CP_START_DATE_SK >= 2452640


Optimized Statement:
-------------------
SELECT 
  Q1.CP_START_DATE_SK AS "CP_START_DATE_SK",
  Q2.D_FY_QUARTER_SEQ AS "D_FY_QUARTER_SEQ" 
FROM 
  TPCDS.CATALOG_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CP_END_DATE_SK) AND 
  (2452640 <= Q1.CP_START_DATE_SK) AND 
  (2451543 <= Q1.CP_END_DATE_SK)

