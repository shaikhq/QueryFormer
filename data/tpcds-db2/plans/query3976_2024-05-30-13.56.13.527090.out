Original Statement:
------------------
SELECT 
  TPCDS.DATE_DIM2.D_QUARTER_SEQ,
  TPCDS.CUSTOMER.C_CUSTOMER_SK 
FROM 
  TPCDS.DATE_DIM2 
  INNER JOIN TPCDS.CUSTOMER 
  ON TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK = TPCDS.DATE_DIM2.D_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_BIRTH_YEAR <= 1965 AND 
  TPCDS.CUSTOMER.C_BIRTH_DAY = 18


Optimized Statement:
-------------------
SELECT 
  Q1.D_QUARTER_SEQ AS "D_QUARTER_SEQ",
  Q2.C_CUSTOMER_SK AS "C_CUSTOMER_SK" 
FROM 
  TPCDS.DATE_DIM2 AS Q1,
  TPCDS.CUSTOMER AS Q2 
WHERE 
  (Q2.C_FIRST_SHIPTO_DATE_SK = Q1.D_DATE_SK) AND 
  (Q2.C_BIRTH_DAY = 18) AND 
  (Q2.C_BIRTH_YEAR <= 1965)

