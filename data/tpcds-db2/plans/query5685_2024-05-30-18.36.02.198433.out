Original Statement:
------------------
SELECT 
  TPCDS.WEB_PAGE.WP_CHAR_COUNT,
  TPCDS.DATE_DIM2.D_DATE_SK 
FROM 
  TPCDS.WEB_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK 
WHERE 
  TPCDS.WEB_PAGE.WP_MAX_AD_COUNT <= 3 AND 
  TPCDS.WEB_PAGE.WP_ACCESS_DATE_SK = 2452611


Optimized Statement:
-------------------
SELECT 
  Q1.WP_CHAR_COUNT AS "WP_CHAR_COUNT",
  2452611 AS "D_DATE_SK" 
FROM 
  TPCDS.WEB_PAGE AS Q1 
WHERE 
  (Q1.WP_ACCESS_DATE_SK = 2452611) AND 
  (Q1.WP_MAX_AD_COUNT <= 3)

