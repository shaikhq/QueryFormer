Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_EXT_LIST_PRICE,
  TPCDS.DATE_DIM2.D_YEAR 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.CATALOG_SALES.CS_ORDER_NUMBER = 123678 AND 
  TPCDS.DATE_DIM2.D_DOM <= 12


Optimized Statement:
-------------------
SELECT 
  Q1.CS_EXT_LIST_PRICE AS "CS_EXT_LIST_PRICE",
  Q2.D_YEAR AS "D_YEAR" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (Q2.D_DOM <= 12) AND 
  (Q1.CS_ORDER_NUMBER = 123678)

