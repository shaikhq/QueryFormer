Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_PROMO_SK,
  TPCDS.DATE_DIM2.D_FY_QUARTER_SEQ 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_FY_WEEK_SEQ >= 1721 AND 
  TPCDS.CATALOG_SALES.CS_EXT_LIST_PRICE = +08227.95


Optimized Statement:
-------------------
SELECT 
  Q1.CS_PROMO_SK AS "CS_PROMO_SK",
  Q2.D_FY_QUARTER_SEQ AS "D_FY_QUARTER_SEQ" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (Q1.CS_EXT_LIST_PRICE = +08227.95) AND 
  (1721 <= Q2.D_FY_WEEK_SEQ)

