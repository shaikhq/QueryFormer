Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_PAGE.CP_CATALOG_NUMBER,
  TPCDS.DATE_DIM2.D_LAST_DOM 
FROM 
  TPCDS.CATALOG_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_PAGE.CP_END_DATE_SK 
WHERE 
  TPCDS.CATALOG_PAGE.CP_END_DATE_SK >= 2452729 AND 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_NUMBER >= 18


Optimized Statement:
-------------------
SELECT 
  Q1.CP_CATALOG_NUMBER AS "CP_CATALOG_NUMBER",
  Q2.D_LAST_DOM AS "D_LAST_DOM" 
FROM 
  TPCDS.CATALOG_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CP_END_DATE_SK) AND 
  (18 <= Q1.CP_CATALOG_PAGE_NUMBER) AND 
  (2452729 <= Q1.CP_END_DATE_SK)

