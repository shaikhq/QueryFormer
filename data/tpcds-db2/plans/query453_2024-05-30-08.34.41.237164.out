Original Statement:
------------------
SELECT 
  TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK,
  TPCDS.DATE_DIM2.D_MONTH_SEQ 
FROM 
  TPCDS.CUSTOMER 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK 
WHERE 
  TPCDS.CUSTOMER.C_FIRST_SHIPTO_DATE_SK <= 2452017 AND 
  TPCDS.DATE_DIM2.D_DATE_SK >= 2438089


Optimized Statement:
-------------------
SELECT 
  Q1.C_FIRST_SHIPTO_DATE_SK AS "C_FIRST_SHIPTO_DATE_SK",
  Q2.D_MONTH_SEQ AS "D_MONTH_SEQ" 
FROM 
  TPCDS.CUSTOMER AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (2438089 <= Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q2.D_DATE_SK = Q1.C_FIRST_SHIPTO_DATE_SK) AND 
  (Q1.C_FIRST_SHIPTO_DATE_SK <= 2452017)

