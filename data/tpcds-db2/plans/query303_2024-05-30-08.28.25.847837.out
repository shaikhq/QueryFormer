Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_EXT_DISCOUNT_AMT,
  TPCDS.DATE_DIM2.D_DOW 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_ORDER_NUMBER = 8640 AND 
  TPCDS.WEB_SALES.WS_WAREHOUSE_SK = 3


Optimized Statement:
-------------------
SELECT 
  Q1.WS_EXT_DISCOUNT_AMT AS "WS_EXT_DISCOUNT_AMT",
  Q2.D_DOW AS "D_DOW" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (Q1.WS_WAREHOUSE_SK = 3) AND 
  (Q1.WS_ORDER_NUMBER = 8640)

