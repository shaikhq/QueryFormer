Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_WAREHOUSE_SK,
  TPCDS.DATE_DIM2.D_SAME_DAY_LY 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.CATALOG_SALES.CS_SOLD_DATE_SK = 2451813 AND 
  TPCDS.CATALOG_SALES.CS_SHIP_HDEMO_SK >= 407


Optimized Statement:
-------------------
SELECT 
  Q1.CS_WAREHOUSE_SK AS "CS_WAREHOUSE_SK",
  Q2.D_SAME_DAY_LY AS "D_SAME_DAY_LY" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (407 <= Q1.CS_SHIP_HDEMO_SK) AND 
  (Q1.CS_SOLD_DATE_SK = 2451813)

