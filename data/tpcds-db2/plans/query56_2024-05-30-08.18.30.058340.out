Original Statement:
------------------
SELECT 
  TPCDS.WEB_SITE.WEB_COMPANY_ID,
  TPCDS.DATE_DIM2.D_FY_WEEK_SEQ 
FROM 
  TPCDS.WEB_SITE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SITE.WEB_CLOSE_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_SAME_DAY_LQ >= 2414988 AND 
  TPCDS.DATE_DIM2.D_DOM <= 31


Optimized Statement:
-------------------
SELECT 
  Q1.WEB_COMPANY_ID AS "WEB_COMPANY_ID",
  Q2.D_FY_WEEK_SEQ AS "D_FY_WEEK_SEQ" 
FROM 
  TPCDS.WEB_SITE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WEB_CLOSE_DATE_SK) AND 
  (Q2.D_DOM <= 31) AND 
  (2414988 <= Q2.D_SAME_DAY_LQ)

