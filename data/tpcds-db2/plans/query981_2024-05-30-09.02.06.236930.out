Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_SALES.CS_EXT_WHOLESALE_COST,
  TPCDS.DATE_DIM2.D_FY_WEEK_SEQ 
FROM 
  TPCDS.CATALOG_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_SALES.CS_SHIP_DATE_SK 
WHERE 
  TPCDS.CATALOG_SALES.CS_ITEM_SK >= 15739 AND 
  TPCDS.CATALOG_SALES.CS_BILL_ADDR_SK >= 18519


Optimized Statement:
-------------------
SELECT 
  Q1.CS_EXT_WHOLESALE_COST AS "CS_EXT_WHOLESALE_COST",
  Q2.D_FY_WEEK_SEQ AS "D_FY_WEEK_SEQ" 
FROM 
  TPCDS.CATALOG_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CS_SHIP_DATE_SK) AND 
  (18519 <= Q1.CS_BILL_ADDR_SK) AND 
  (15739 <= Q1.CS_ITEM_SK)

