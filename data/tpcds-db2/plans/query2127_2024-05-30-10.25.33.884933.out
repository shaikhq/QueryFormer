Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_SHIP_CUSTOMER_SK,
  TPCDS.DATE_DIM2.D_YEAR 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_ITEM_SK = 14227 AND 
  TPCDS.DATE_DIM2.D_DOM >= 1


Optimized Statement:
-------------------
SELECT 
  Q1.WS_SHIP_CUSTOMER_SK AS "WS_SHIP_CUSTOMER_SK",
  Q2.D_YEAR AS "D_YEAR" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (1 <= Q2.D_DOM) AND 
  (Q1.WS_ITEM_SK = 14227)

