Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_NUMBER,
  TPCDS.DATE_DIM2.D_FIRST_DOM 
FROM 
  TPCDS.CATALOG_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_PAGE.CP_END_DATE_SK 
WHERE 
  TPCDS.DATE_DIM2.D_DATE_SK <= 2465002 AND 
  TPCDS.CATALOG_PAGE.CP_END_DATE_SK >= 2452456


Optimized Statement:
-------------------
SELECT 
  Q1.CP_CATALOG_PAGE_NUMBER AS "CP_CATALOG_PAGE_NUMBER",
  Q2.D_FIRST_DOM AS "D_FIRST_DOM" 
FROM 
  TPCDS.CATALOG_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q1.CP_END_DATE_SK <= 2465002) AND 
  (Q2.D_DATE_SK = Q1.CP_END_DATE_SK) AND 
  (2452456 <= Q1.CP_END_DATE_SK)

