Original Statement:
------------------
SELECT 
  TPCDS.CATALOG_PAGE.CP_END_DATE_SK,
  TPCDS.DATE_DIM2.D_QOY 
FROM 
  TPCDS.CATALOG_PAGE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.CATALOG_PAGE.CP_END_DATE_SK 
WHERE 
  TPCDS.CATALOG_PAGE.CP_CATALOG_PAGE_NUMBER = 74 AND 
  TPCDS.DATE_DIM2.D_DOW = 4


Optimized Statement:
-------------------
SELECT 
  Q1.CP_END_DATE_SK AS "CP_END_DATE_SK",
  Q2.D_QOY AS "D_QOY" 
FROM 
  TPCDS.CATALOG_PAGE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.CP_END_DATE_SK) AND 
  (Q2.D_DOW = 4) AND 
  (Q1.CP_CATALOG_PAGE_NUMBER = 74)

