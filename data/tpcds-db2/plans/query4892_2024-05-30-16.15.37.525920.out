Original Statement:
------------------
SELECT 
  TPCDS.STORE.S_NUMBER_EMPLOYEES,
  TPCDS.DATE_DIM2.D_FY_WEEK_SEQ 
FROM 
  TPCDS.STORE 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.STORE.S_CLOSED_DATE_SK 
WHERE 
  TPCDS.STORE.S_DIVISION_ID = 1 AND 
  TPCDS.STORE.S_STORE_SK <= 5


Optimized Statement:
-------------------
SELECT 
  Q1.S_NUMBER_EMPLOYEES AS "S_NUMBER_EMPLOYEES",
  Q2.D_FY_WEEK_SEQ AS "D_FY_WEEK_SEQ" 
FROM 
  TPCDS.STORE AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.S_CLOSED_DATE_SK) AND 
  (Q1.S_STORE_SK <= 5) AND 
  (Q1.S_DIVISION_ID = 1)

