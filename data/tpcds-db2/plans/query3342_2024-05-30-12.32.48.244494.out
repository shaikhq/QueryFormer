Original Statement:
------------------
SELECT 
  TPCDS.WEB_SALES.WS_WAREHOUSE_SK,
  TPCDS.DATE_DIM2.D_MONTH_SEQ 
FROM 
  TPCDS.WEB_SALES 
  INNER JOIN TPCDS.DATE_DIM2 
  ON TPCDS.DATE_DIM2.D_DATE_SK = TPCDS.WEB_SALES.WS_SHIP_DATE_SK 
WHERE 
  TPCDS.WEB_SALES.WS_BILL_CDEMO_SK <= 267870 AND 
  TPCDS.WEB_SALES.WS_ITEM_SK = 2843


Optimized Statement:
-------------------
SELECT 
  Q1.WS_WAREHOUSE_SK AS "WS_WAREHOUSE_SK",
  Q2.D_MONTH_SEQ AS "D_MONTH_SEQ" 
FROM 
  TPCDS.WEB_SALES AS Q1,
  TPCDS.DATE_DIM2 AS Q2 
WHERE 
  (Q2.D_DATE_SK = Q1.WS_SHIP_DATE_SK) AND 
  (Q1.WS_ITEM_SK = 2843) AND 
  (Q1.WS_BILL_CDEMO_SK <= 267870)

